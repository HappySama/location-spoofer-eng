#!name=Apple WLOC Location Spoofer
#!desc=Modifies coordinates returned by Apple network location services | Recommended Shortcuts: Set Location https://www.icloud.com/shortcuts/a82717d8fdad4e6280866fcf911173f7 Restore Real Location https://www.icloud.com/shortcuts/f42632d406504f24a2cd163af4fe012f | Location picker: https://wloc-pages.pages.dev/
#!author=xweiba
#!homepage=https://github.com/xweiba/location-spoofer
#!category=Tools
#!arguments=Longitude:113.94114, Latitude:22.544577, Accuracy:25, Log Level:info
#!arguments-desc=Longitude/Latitude: Default coordinates (coordinates stored through the online picker take priority)\nAccuracy: GPS accuracy in meters\nLog Level: off/error/warn/info/debug/all\n\nUsage: Open the location picker -> select a location -> save it to the device

[Script]
Apple WLOC = type=http-response, pattern="^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc", requires-body=1, binary-body-mode=1, max-size=0, timeout=30, script-path=https://gh-proxy.org/https://raw.githubusercontent.com/xweiba/location-spoofer/main/ThirdParty/WlocScripts/dist/v1/wloc.js
WLOC Settings = type=http-request, pattern="^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/(save|version)", requires-body=0, max-size=0, timeout=10, script-path=https://gh-proxy.org/https://raw.githubusercontent.com/xweiba/location-spoofer/main/ThirdParty/WlocScripts/dist/v1/wloc-settings.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com
